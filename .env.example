# Copier ce fichier en .env et remplir les valeurs. Ne jamais committer .env.

# Webhook n8n / Make qui reçoit les formulaires (contact et devis)
FORM_WEBHOOK_URL=

# Adresse appelée par les formulaires depuis le navigateur (site statique : visible publiquement).
# En v1 : le webhook n8n / Make lui-même, protégé par validation et filtrage du spam.
PUBLIC_FORM_ENDPOINT=

# Numéro WhatsApp au format international sans + ni espaces (défaut : 50946894829)
PUBLIC_WHATSAPP_NUMBER=

# Lien de réservation Cal.com (défaut : compte de l'agence)
PUBLIC_BOOKING_URL=

# URL du site en production (domaine à définir)
PUBLIC_SITE_URL=https://clickerscommunity.com
