---
import NetworkPattern from '../components/ui/NetworkPattern.astro';
import Button from '../components/ui/Button.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getLocalizedPath, useTranslations } from '../i18n/utils';

// Page commune aux deux langues : le français d'abord, l'anglais en dessous
const fr = useTranslations('fr');
const en = useTranslations('en');
---

<BaseLayout title={fr('notFound.title')} description={fr('notFound.text')}>
  <section class="relative isolate overflow-hidden bg-night-900 text-brand-100">
    <NetworkPattern class="pointer-events-none absolute -right-32 -bottom-48 -z-10 size-[36rem] text-brand-300 opacity-[0.1]" />
    <div class="mx-auto max-w-3xl px-4 py-24 text-center md:px-8 md:py-32">
      <p class="font-display text-7xl font-semibold text-accent-300 md:text-8xl">404</p>
      <h1 class="mt-6 text-3xl text-paper md:text-4xl">{fr('notFound.title')}</h1>
      <p class="mt-4 text-brand-100/85">{fr('notFound.text')}</p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <Button href={getLocalizedPath('home', 'fr')} variant="accent">
          {fr('notFound.home')}
        </Button>
        <Button href={getLocalizedPath('contact', 'fr')} variant="outline-light">
          {fr('nav.contact')}
        </Button>
      </div>
      <div lang="en" class="mt-14 border-t border-accent-500/20 pt-8 text-sm text-brand-100/75">
        <p>{en('notFound.text')}</p>
        <a
          href={getLocalizedPath('home', 'en')}
          class="mt-3 inline-block text-accent-300 hover:text-paper"
        >
          {en('notFound.home')} →
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
