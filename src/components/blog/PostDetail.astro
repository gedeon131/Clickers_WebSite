---
/**
 * Article de blog, partagé par /blog/[slug] et /en/blog/[slug].
 */
import { render } from 'astro:content';
import LatestPosts from './LatestPosts.astro';
import Newsletter from '../forms/Newsletter.astro';
import PageHeader from '../ui/PageHeader.astro';
import type { LocalizedEntry } from '../../lib/content';
import { getLangFromUrl, getLocalizedPath, useTranslations } from '../../i18n/utils';

interface Props {
  item: LocalizedEntry<'blog'>;
}

const { item } = Astro.props;
const { entry, fallback } = item;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { Content } = await render(entry);
const date = new Intl.DateTimeFormat(lang === 'fr' ? 'fr-FR' : 'en-GB', { dateStyle: 'long' }).format(
  entry.data.date,
);
---

<PageHeader
  eyebrow={entry.data.category}
  title={entry.data.title}
  intro={entry.data.description}
  breadcrumbs={[
    { label: t('blog.title'), href: getLocalizedPath('blog', lang) },
    { label: entry.data.title },
  ]}
>
  <p class="mt-6 font-mono text-sm text-brand-100/70">
    <time datetime={entry.data.date.toISOString()}>{date}</time>
    {` · ${entry.data.readingTime} ${t('blog.minutes')}`}
  </p>
  {fallback && (
    <p lang="fr" class="mt-2 text-sm text-brand-100/70 italic">
      {t('content.fallback')}
    </p>
  )}
</PageHeader>

<section class="bg-paper">
  <article class="prose-site mx-auto max-w-3xl px-4 py-16 md:px-8 md:py-24" lang={fallback ? 'fr' : undefined}>
    <Content />
    <p>
      <a href={getLocalizedPath('blog', lang)}>← {t('blog.back')}</a>
    </p>
  </article>
</section>

<LatestPosts exclude={item.slug} title={t('blog.others')} />

<Newsletter />
