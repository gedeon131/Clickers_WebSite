---
/**
 * Balise <form> commune : type de demande, adresse d'envoi et messages traduits pour le script d'envoi.
 */
import { contactEmail, formEndpoint } from '../../config/site';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

interface Props {
  type: 'contact' | 'devis' | 'avis' | 'newsletter';
  id: string;
  labelledby: string;
  /** Message de succès propre au formulaire (par défaut : message générique). */
  successMessage?: string;
  /** Classes de mise en page (par défaut : grille deux colonnes). */
  class?: string;
}

const { type, id, labelledby, successMessage, class: className } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<form
  id={id}
  aria-labelledby={labelledby}
  novalidate
  data-site-form
  data-type={type}
  data-lang={lang}
  data-endpoint={formEndpoint}
  data-msg-invalid={t('form.invalid')}
  data-msg-sending={t('form.sending')}
  data-msg-success={successMessage ?? t('form.success')}
  data-msg-error={`${t('form.error')} ${contactEmail}`}
  data-msg-inactive={`${t('form.inactive')} ${contactEmail}`}
  class:list={[className ?? 'relative grid grid-cols-[minmax(0,1fr)] gap-6 md:grid-cols-2']}
>
  <slot />
</form>

<script>
  import { initForms } from '../../lib/forms';
  initForms();
</script>
