---
/**
 * Inscription à la newsletter (inspirée de ddghaiti.com) : e-mail + consentement,
 * envoyée au webhook avec `type: "newsletter"`.
 */
import FormShell from './FormShell.astro';
import { getLangFromUrl, getLocalizedPath, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const p = 'newsletter';
---

<section class="relative isolate overflow-hidden bg-night-800 text-brand-100" aria-labelledby="newsletter-titre">
  <div class="bg-dots absolute inset-0 -z-10 opacity-50" aria-hidden="true"></div>
  <div class="mx-auto grid max-w-7xl gap-8 px-4 py-14 md:px-8 md:py-16 lg:grid-cols-12 lg:items-center">
    <div class="lg:col-span-5">
      <h2 id="newsletter-titre" class="text-2xl text-white md:text-3xl">{t('newsletter.title')}</h2>
      <p class="mt-3 text-brand-100/80">{t('newsletter.text')}</p>
    </div>
    <div class="lg:col-span-7">
      <FormShell
        type="newsletter"
        id="formulaire-newsletter"
        labelledby="newsletter-titre"
        successMessage={t('newsletter.success')}
        class="relative flex flex-col gap-4"
      >
        <div class="flex flex-col gap-3 sm:flex-row">
          <label for={`${p}-email`} class="sr-only">{t('newsletter.email')}</label>
          <input
            id={`${p}-email`}
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder={t('newsletter.email')}
            class="w-full flex-1 rounded-lg border border-brand-300/30 bg-night-900 px-4 py-3 text-base text-white placeholder:text-brand-100/50 focus:border-accent-300 focus:ring-2 focus:ring-accent-500/40 focus:outline-none"
          />
          <button
            type="submit"
            class="btn-gradient inline-flex items-center justify-center gap-2 rounded-lg px-6 py-3 text-sm font-semibold text-white disabled:cursor-wait disabled:opacity-70"
          >
            <span data-submit-label>{t('newsletter.submit')}</span>
          </button>
        </div>
        <div class="absolute -left-[9999px] h-px w-px overflow-hidden" aria-hidden="true">
          <label for={`${p}-website`}>Website</label>
          <input id={`${p}-website`} name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>
        <div class="flex items-start gap-3">
          <input
            id={`${p}-consent`}
            name="consent"
            type="checkbox"
            value="oui"
            required
            class="mt-1 size-4 shrink-0 accent-accent-500"
          />
          <label for={`${p}-consent`} class="text-sm text-brand-100/75">
            {`${t('newsletter.consent')} `}
            <a href={getLocalizedPath('privacy', lang)} class="text-accent-300 underline underline-offset-4">
              {t('form.consentLink')}
            </a>
            .
          </label>
        </div>
        <p
          data-form-status
          role="status"
          aria-live="polite"
          hidden
          class="rounded-lg border px-4 py-3 text-sm data-[tone=error]:border-accent-300/60 data-[tone=error]:text-accent-300 data-[tone=success]:border-success-300/50 data-[tone=success]:text-success-300"
        ></p>
      </FormShell>
    </div>
  </div>
</section>
