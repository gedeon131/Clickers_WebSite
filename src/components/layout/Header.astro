---
import LanguageSwitcher from './LanguageSwitcher.astro';
import LogoMark from '../ui/LogoMark.astro';
import { getBookingLink } from '../../config/site';
import {
  getCurrentPath,
  getLangFromUrl,
  getLocalizedPath,
  getRoutePath,
  useTranslations,
  type RouteKey,
  type UiKey,
} from '../../i18n/utils';

interface Props {
  /** Transparent au-dessus du hero, opaque dès que la page défile. */
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const items: { key: RouteKey; label: UiKey }[] = [
  { key: 'home', label: 'nav.home' },
  { key: 'about', label: 'nav.about' },
  { key: 'services', label: 'nav.services' },
  { key: 'projects', label: 'nav.projects' },
  { key: 'blog', label: 'nav.blog' },
  { key: 'contact', label: 'nav.contact' },
];

const current = getCurrentPath(Astro.url);

const links = items.map(({ key, label }) => {
  const href = getLocalizedPath(key, lang);
  const target = getRoutePath(key, lang);
  const isHome = key === 'home';
  const active = isHome
    ? current === target
    : current === target || current.startsWith(`${target}/`);
  return { href, label: t(label), active };
});

const booking = getBookingLink(
  t('nav.cta'),
  t('booking.newTab'),
  getLocalizedPath('contact', lang),
);
---

<header
  class:list={[
    'site-header top-0 z-40 w-full border-b border-accent-500/20 bg-night-900/95 backdrop-blur transition-colors duration-300',
    overlay ? 'fixed' : 'sticky',
  ]}
  data-overlay={overlay ? '' : undefined}
>
  <a
    href="#contenu"
    class="sr-only rounded-md bg-accent-300 px-4 py-2 text-sm font-medium text-night-900 focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50"
  >
    {t('nav.skip')}
  </a>

  <!-- Barre utilitaire (grands écrans) -->
  <div class="hidden border-b border-accent-500/15 md:block">
    <div class="mx-auto flex h-9 max-w-7xl items-center justify-between px-4 text-[0.6875rem] text-brand-100/75 md:px-8">
      <p class="font-mono tracking-normal"><span class="text-accent-300" aria-hidden="true">// </span>{t('site.baseline')}</p>
      <p class="text-sm font-medium text-brand-100/90">{t('site.tagline')}</p>
    </div>
  </div>

  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 md:h-20 md:px-8">
    <a href={getLocalizedPath('home', lang)} class="group flex items-center gap-3 no-underline">
      <LogoMark class="size-10 shrink-0 transition-transform group-hover:scale-105 md:size-12" />
      <span class="flex flex-col leading-tight">
        <span class="font-display text-base font-bold tracking-tight text-white md:text-lg">
          Clickers
        </span>
        <span class="font-display text-[0.6875rem] font-medium tracking-[0.25em] text-brand-300 uppercase">Community</span>
      </span>
    </a>

    <nav aria-label={t('nav.main')} class="hidden lg:block">
      <ul class="flex items-center gap-8">
        {links.map(({ href, label, active }) => (
          <li>
            <a
              href={href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'relative py-2 text-sm font-medium no-underline transition-colors',
                'after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:origin-left after:bg-linear-to-r after:from-brand-300 after:to-accent-300 after:transition-transform',
                active
                  ? 'text-accent-300 after:scale-x-100'
                  : 'text-brand-100 after:scale-x-0 hover:text-paper hover:after:scale-x-100',
              ]}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <a
        {...booking}
        class="hidden rounded-md btn-gradient px-4 py-2.5 text-xs font-semibold tracking-[0.15em] text-white uppercase no-underline transition-colors md:inline-flex"
      >
        {t('nav.cta')}
      </a>
      <LanguageSwitcher />
      <button
        type="button"
        class="inline-flex size-10 items-center justify-center rounded-md text-paper hover:text-accent-300 lg:hidden"
        aria-controls="menu-mobile"
        aria-expanded="false"
        data-menu-toggle
        data-label-open={t('nav.menu.open')}
        data-label-close={t('nav.menu.close')}
      >
        <span class="sr-only" data-menu-label>
          {t('nav.menu.open')}
        </span>
        <svg
          class="size-6"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <path data-menu-icon="open" stroke-linecap="round" d="M4 7h16M4 12h16M4 17h16"></path>
          <path
            data-menu-icon="close"
            class="hidden"
            stroke-linecap="round"
            d="M6 6l12 12M18 6L6 18"
          ></path>
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="menu-mobile"
    aria-label={t('nav.main')}
    class="hidden border-t border-accent-500/20 bg-night-900 lg:hidden"
    data-menu-panel
  >
    <ul class="mx-auto flex max-w-7xl flex-col px-4 py-4">
      {links.map(({ href, label, active }) => (
        <li>
          <a
            href={href}
            aria-current={active ? 'page' : undefined}
            class:list={[
              'block border-b border-night-800 py-3 text-base font-medium no-underline',
              active ? 'text-accent-300' : 'text-brand-100 hover:text-paper',
            ]}
          >
            {label}
          </a>
        </li>
      ))}
      <li class="pt-4 md:hidden">
        <a
          {...booking}
          class="block rounded-md btn-gradient px-4 py-3 text-center text-xs font-semibold tracking-[0.15em] text-white uppercase no-underline"
        >
          {t('nav.cta')}
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const panel = document.querySelector<HTMLElement>('[data-menu-panel]');

  if (toggle && panel) {
    const label = toggle.querySelector<HTMLElement>('[data-menu-label]');
    const iconOpen = toggle.querySelector('[data-menu-icon="open"]');
    const iconClose = toggle.querySelector('[data-menu-icon="close"]');

    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      toggle.closest('header')?.toggleAttribute('data-menu-open', open);
      panel.classList.toggle('hidden', !open);
      iconOpen?.classList.toggle('hidden', open);
      iconClose?.classList.toggle('hidden', !open);
      if (label) {
        label.textContent = (open ? toggle.dataset.labelClose : toggle.dataset.labelOpen) ?? '';
      }
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    window.matchMedia('(min-width: 64rem)').addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }

  // Header superposé : devient opaque dès que la page défile
  const header = document.querySelector<HTMLElement>('.site-header[data-overlay]');
  if (header) {
    const update = () => header.toggleAttribute('data-scrolled', window.scrollY > 24);
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
</script>

<style>
  .site-header[data-overlay]:not([data-scrolled]):not([data-menu-open]) {
    background-color: transparent;
    border-color: transparent;
    backdrop-filter: none;
  }
</style>
