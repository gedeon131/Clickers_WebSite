---
/**
 * Nos engagements (présentation §5.2 à 5.4) : collaboration, qualité, délais.
 */
import Section from '../ui/Section.astro';
import { getLangFromUrl, useTranslations, type UiKey } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const items = [
  {
    key: 'collaboration',
    // Bulles de discussion
    icon: 'M4 5h11v8H8l-4 3zM9 16v1h7l4 3v-8h-3',
  },
  {
    key: 'quality',
    // Bouclier coché
    icon: 'M12 3l7 3v5c0 4.5-3 8.3-7 10-4-1.7-7-5.5-7-10V6zM9 12l2 2 4-4',
  },
  {
    key: 'deadlines',
    // Horloge
    icon: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM12 7v5l3 2',
  },
].map(({ key, icon }) => ({
  title: t(`commitment.${key}.title` as UiKey),
  text: t(`commitment.${key}.text` as UiKey),
  icon,
}));
---

<Section id="engagements" tone="paper" eyebrow={t('commitments.eyebrow')} title={t('commitments.title')}>
  <ul class="grid gap-6 md:grid-cols-3" role="list">
    {items.map(({ title, text, icon }, index) => (
      <li
        data-reveal
        class="rounded-xl border border-brand-100 bg-white p-7 shadow-sm shadow-night-900/5 md:p-8"
        style={`transition-delay: ${index * 80}ms`}
      >
        <svg
          class="size-9 text-accent-700"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d={icon} />
        </svg>
        <h3 class="mt-6 text-xl">{title}</h3>
        <p class="mt-3 text-muted">{text}</p>
      </li>
    ))}
  </ul>
</Section>
