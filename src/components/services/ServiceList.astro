---
/**
 * Liste numérotée des domaines d'intervention : une ligne par service, entièrement cliquable.
 */
import ServiceIcon from '../ui/ServiceIcon.astro';
import type { LocalizedEntry } from '../../lib/content';
import { getDetailPath, getLangFromUrl, useTranslations } from '../../i18n/utils';

interface Props {
  items: LocalizedEntry<'services'>[];
  /** Fond de la section qui contient la liste (adapte la couleur de survol). */
  tone?: 'paper' | 'tint';
}

const { items, tone = 'tint' } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<ol class="border-t border-brand-700/15" role="list">
  {items.map(({ slug, entry, fallback }, index) => (
    <li data-reveal class="group relative border-b border-brand-700/15">
      <div
        class:list={[
          'grid gap-4 py-7 transition-[padding,background-color] duration-300 md:grid-cols-12 md:items-center md:gap-8 md:px-4 md:group-hover:px-8',
          tone === 'tint' ? 'group-hover:bg-white/80' : 'group-hover:bg-brand-100/60',
        ]}
      >
        <div class="flex items-center gap-4 md:col-span-5">
          <span class="font-mono text-sm text-muted">{String(index + 1).padStart(2, '0')}</span>
          <span class="flex size-11 shrink-0 items-center justify-center rounded-lg bg-brand-100 text-brand-700 transition-colors group-hover:bg-linear-to-br group-hover:from-brand-700 group-hover:to-accent-500 group-hover:text-white">
            <ServiceIcon name={entry.data.icon} class="size-6" />
          </span>
          <h3 class="text-lg md:text-xl" lang={fallback ? 'fr' : undefined}>
            <a
              href={getDetailPath('services', slug, lang)}
              class="no-underline after:absolute after:inset-0"
            >
              {entry.data.title}
            </a>
          </h3>
        </div>
        <p class="text-muted md:col-span-6" lang={fallback ? 'fr' : undefined}>
          {entry.data.summary}
          {fallback && (
            <span lang="fr" class="mt-1 block text-xs italic">
              {t('content.fallback')}
            </span>
          )}
        </p>
        <div class="hidden justify-end md:col-span-1 md:flex">
          <span
            class="flex size-10 shrink-0 items-center justify-center rounded-full border border-brand-700/25 text-brand-700 transition-all group-hover:translate-x-1 group-hover:border-brand-700 group-hover:bg-brand-700 group-hover:text-white"
            aria-hidden="true"
          >
            →
          </span>
        </div>
      </div>
    </li>
  ))}
</ol>
