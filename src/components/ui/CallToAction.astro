---
import Button from '../ui/Button.astro';
import NetworkPattern from './NetworkPattern.astro';
import { contactEmail, getBookingLink, phoneDisplay, phoneHref } from '../../config/site';
import { getLangFromUrl, getLocalizedPath, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const contact = getLocalizedPath('contact', lang);
const booking = getBookingLink(t('home.cta.primary'), t('booking.newTab'), contact);
---

<section
  class="relative isolate overflow-hidden bg-linear-to-br from-brand-700 via-brand-700 to-accent-700 text-brand-100"
  aria-labelledby="cta-titre"
>
  <NetworkPattern
    class="pointer-events-none absolute -top-32 -right-32 -z-10 size-[34rem] text-white opacity-[0.12]"
  />
  <div class="bg-dots absolute inset-0 -z-20 opacity-40" aria-hidden="true"></div>

  <div
    data-reveal
    class="mx-auto grid max-w-7xl gap-10 px-4 py-20 md:px-8 md:py-24 lg:grid-cols-12 lg:items-end"
  >
    <div class="lg:col-span-7">
      <h2 id="cta-titre" class="text-3xl leading-tight text-white md:text-5xl">
        {t('home.cta.title')}
      </h2>
      <p class="mt-6 max-w-xl text-white/90 md:text-lg">{t('home.cta.text')}</p>
      <p class="mt-6 flex flex-wrap gap-x-6 gap-y-2 font-mono text-sm">
        <a href={`mailto:${contactEmail}`} class="break-all text-white no-underline hover:underline">
          {contactEmail}
        </a>
        <a href={phoneHref} class="text-white no-underline hover:underline">{phoneDisplay}</a>
      </p>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row lg:col-span-5 lg:justify-end">
      <Button {...booking} variant="light" size="lg">
        {t('home.cta.primary')}
        <span aria-hidden="true">→</span>
      </Button>
      <Button href={`${contact}#devis`} variant="outline-white" size="lg">
        {t('home.cta.secondary')}
      </Button>
    </div>
  </div>
</section>
