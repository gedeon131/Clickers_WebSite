---
/**
 * Illustration « l'idée devient solution » : une ampoule (couverture du document de présentation)
 * contenant les barres et la flèche de croissance du logo, entourée de rayons.
 */
interface Props {
  class?: string;
  /** Texte alternatif ; vide = décoratif. */
  label?: string;
}

const { class: className, label } = Astro.props;
const id = `idee-${Math.random().toString(36).slice(2, 8)}`;
---

<svg
  viewBox="0 0 300 300"
  fill="none"
  class={className}
  role={label ? 'img' : undefined}
  aria-label={label || undefined}
  aria-hidden={label ? undefined : 'true'}
>
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="var(--color-brand-500)"></stop>
      <stop offset="1" stop-color="var(--color-accent-500)"></stop>
    </linearGradient>
  </defs>

  <!-- Rayons -->
  <g stroke={`url(#${id})`} stroke-width="6" stroke-linecap="round">
    <path d="M150 18v22M62 52l15 15M238 52l-15 15M30 138h22M270 138h-22"></path>
  </g>

  <!-- Ampoule -->
  <path
    d="M150 62c-44 0-78 33-78 76 0 27 13 47 30 62 9 8 14 18 14 29v9h68v-9c0-11 5-21 14-29 17-15 30-35 30-62 0-43-34-76-78-76z"
    fill="var(--color-paper)"
    stroke={`url(#${id})`}
    stroke-width="8"
    stroke-linejoin="round"
  ></path>
  <path d="M120 254h60M128 272h44" stroke="var(--color-brand-700)" stroke-width="8" stroke-linecap="round"
  ></path>

  <!-- Barres et flèche du logo -->
  <rect x="112" y="150" width="18" height="40" rx="2" fill="var(--color-steel-300)"></rect>
  <rect x="138" y="132" width="18" height="58" rx="2" fill="var(--color-steel-500)"></rect>
  <rect x="164" y="112" width="18" height="78" rx="2" fill="var(--color-steel-700)"></rect>
  <path
    d="M104 172l26-20 16 10 40-38"
    stroke="var(--color-brand-700)"
    stroke-width="8"
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>
  <path d="M199 109l-6 26-20-20z" fill="var(--color-brand-700)"></path>
</svg>
