---
import type { HTMLAttributes } from 'astro/types';

/**
 * Lien stylé en bouton.
 * - primary : bleu plein, sur fond clair
 * - accent : dégradé bleu → violet (CTA principal), sur tout fond
 * - outline : contour bleu, sur fond clair
 * - outline-light : contour clair, sur fond sombre
 * - light / outline-white : sur fond bleu vif (bandeau d'appel à l'action)
 */
type Variant = 'primary' | 'accent' | 'outline' | 'outline-light' | 'light' | 'outline-white';

interface Props extends HTMLAttributes<'a'> {
  href: string;
  variant?: Variant;
  size?: 'md' | 'lg';
}

const { href, variant = 'primary', size = 'md', class: className, ...rest } = Astro.props;

const variants: Record<Variant, string> = {
  primary: 'bg-brand-700 text-white hover:bg-brand-500',
  accent: 'btn-gradient text-white',
  outline: 'border border-brand-700 text-brand-700 hover:bg-brand-700 hover:text-white',
  'outline-light':
    'border border-brand-300/50 text-white hover:border-accent-300 hover:bg-white/5',
  light: 'bg-white text-brand-700 hover:bg-brand-100',
  'outline-white': 'border border-white/70 text-white hover:bg-white/10',
};

const sizes = {
  md: 'px-5 py-2.5 text-sm',
  lg: 'px-7 py-3.5 text-sm md:text-base',
};
---

<a
  href={href}
  class:list={[
    'inline-flex items-center justify-center gap-2 rounded-lg text-center font-semibold whitespace-nowrap no-underline transition-colors duration-200',
    variants[variant],
    sizes[size],
    className,
  ]}
  {...rest}
>
  <slot />
</a>
