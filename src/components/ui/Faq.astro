---
/**
 * Foire aux questions en accordéon (balises <details>, sans JavaScript).
 * Titre et lien de contact à gauche, questions à droite sur grand écran.
 */
import Button from './Button.astro';
import { getLangFromUrl, getLocalizedPath, useTranslations, type UiKey } from '../../i18n/utils';

export type FaqId =
  | 'process'
  | 'delays'
  | 'quote'
  | 'tech'
  | 'support'
  | 'remote'
  | 'training'
  | 'confidentiality';

interface Props {
  items: FaqId[];
  /** Affiche le bouton « Nous contacter » (inutile sur la page Contact). */
  showContact?: boolean;
}

const { items, showContact = true } = Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const questions = items.map((id) => ({
  id,
  q: t(`faq.${id}.q` as UiKey),
  a: t(`faq.${id}.a` as UiKey),
}));
---

<section id="faq" class="scroll-mt-16 bg-paper md:scroll-mt-28" aria-labelledby="faq-titre">
  <div class="mx-auto grid max-w-7xl grid-cols-[minmax(0,1fr)] gap-10 px-4 py-20 md:px-8 md:py-28 lg:grid-cols-12 lg:gap-16">
    <header data-reveal class="lg:col-span-4">
      <div class="lg:sticky lg:top-36">
        <p class="mb-5 flex items-center gap-4 font-mono text-xs text-accent-700">
          <span aria-hidden="true">//</span>
          {t('faq.eyebrow')}
        </p>
        <h2 id="faq-titre" class="text-3xl leading-[1.15] md:text-4xl">
          {t('faq.title')}
        </h2>
        <p class="mt-6 text-muted">{t('faq.intro')}</p>
        {showContact && (
          <Button href={getLocalizedPath('contact', lang)} variant="outline" class="mt-8">
            {t('faq.contact')}
          </Button>
        )}
      </div>
    </header>

    <!-- PLACEHOLDER : questions et réponses à valider avec la cliente -->
    <div data-reveal class="border-t border-brand-700/15 lg:col-span-8">
      {questions.map(({ id, q, a }, index) => (
        <details class="faq-item group border-b border-brand-700/15" open={index === 0}>
          <summary
            id={`faq-${id}`}
            class="flex cursor-pointer list-none items-center justify-between gap-6 py-6 text-left text-lg font-semibold text-brand-700 transition-colors hover:text-brand-500 md:text-xl"
          >
            {q}
            <span
              class="flex size-9 shrink-0 items-center justify-center rounded-full border border-brand-700/30 text-brand-700 group-open:bg-brand-700 group-open:text-white transition-transform duration-300 group-open:rotate-45"
              aria-hidden="true"
            >
              <svg
                class="size-4"
                viewBox="0 0 16 16"
                fill="none"
                stroke="currentColor"
                stroke-width="1.6"
              >
                <path d="M8 3v10M3 8h10" stroke-linecap="round"></path>
              </svg>
            </span>
          </summary>
          <p class="max-w-3xl pb-7 text-base text-muted md:text-lg">{a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
</style>
