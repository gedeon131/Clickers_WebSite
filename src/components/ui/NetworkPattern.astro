---
/**
 * Motif décoratif « réseau » (nœuds reliés), en filigrane des fonds sombres.
 * Évoque la communauté connectée et le signal Wi-Fi du logo. Couleur : currentColor.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const nodes: [number, number, number][] = [
  [30, 40, 3],
  [90, 22, 4],
  [150, 50, 3],
  [60, 95, 5],
  [125, 105, 3.5],
  [178, 120, 3],
  [25, 150, 3.5],
  [92, 160, 4],
  [150, 175, 3],
];

const links: [number, number][] = [
  [0, 1],
  [1, 2],
  [0, 3],
  [1, 3],
  [1, 4],
  [2, 4],
  [2, 5],
  [3, 4],
  [4, 5],
  [3, 6],
  [3, 7],
  [4, 7],
  [6, 7],
  [7, 8],
  [5, 8],
  [4, 8],
];
---

<svg
  viewBox="0 0 200 200"
  fill="none"
  stroke="currentColor"
  class={className}
  aria-hidden="true"
>
  <g stroke-width="0.5" stroke-opacity="0.8">
    {links.map(([a, b]) => (
      <line x1={nodes[a]![0]} y1={nodes[a]![1]} x2={nodes[b]![0]} y2={nodes[b]![1]} />
    ))}
  </g>
  <g fill="currentColor" stroke="none">
    {nodes.map(([x, y, r]) => <circle cx={x} cy={y} r={r} />)}
  </g>
  <g stroke-width="0.5">
    <circle cx="60" cy="95" r="11"></circle>
    <circle cx="60" cy="95" r="18" stroke-opacity="0.5"></circle>
  </g>
</svg>
