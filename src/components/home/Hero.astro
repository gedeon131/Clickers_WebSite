---
import HeroTerminal from '../react/HeroTerminal';
import Button from '../ui/Button.astro';
import LogoMark from '../ui/LogoMark.astro';
import { getBookingLink } from '../../config/site';
import { getLangFromUrl, getLocalizedPath, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const steps = ([1, 2, 3, 4, 5] as const).map((n) => t(`approach.step${n}.title`));
---

<section
  class="relative isolate flex min-h-svh flex-col overflow-hidden bg-night-900 text-brand-100"
  aria-labelledby="hero-titre"
>
  <!-- Halos bleu et violet (couleurs de l'arc du logo) et trame de points -->
  <div
    class="absolute inset-0 -z-20 bg-[radial-gradient(ellipse_at_15%_85%,color-mix(in_srgb,var(--color-brand-700)_45%,transparent)_0%,transparent_55%),radial-gradient(ellipse_at_85%_15%,color-mix(in_srgb,var(--color-accent-500)_35%,transparent)_0%,transparent_50%)]"
    aria-hidden="true"
  >
  </div>
  <div
    class="bg-dots absolute inset-0 -z-10 [mask-image:radial-gradient(ellipse_at_center,black_30%,transparent_75%)]"
    aria-hidden="true"
  >
  </div>
  <LogoMark
    class="pointer-events-none absolute -right-40 -bottom-40 -z-10 size-[36rem] opacity-[0.07] lg:-right-24"
  />

  <div
    class="mx-auto grid w-full max-w-7xl flex-1 items-center gap-12 px-4 pt-28 pb-14 md:px-8 md:pt-40 lg:grid-cols-12 lg:gap-12 lg:pt-44"
  >
    <div class="hero-reveal lg:col-span-7">
      <p
        class="mb-6 inline-flex items-center gap-3 rounded-full border border-brand-300/25 bg-night-800/60 px-4 py-1.5 font-mono text-xs text-brand-100/90"
      >
        <span class="relative flex size-2" aria-hidden="true">
          <span class="absolute inline-flex size-full animate-ping rounded-full bg-accent-300 opacity-60"
          ></span>
          <span class="relative inline-flex size-2 rounded-full bg-accent-300"></span>
        </span>
        {t('home.hero.eyebrow')}
      </p>
      <h1
        id="hero-titre"
        class="text-[2.6rem] leading-[1.05] text-white sm:text-6xl lg:text-7xl"
      >
        {t('home.hero.title')}
        <span class="text-gradient block pb-1">{t('home.hero.titleHighlight')}</span>
      </h1>
      <p class="mt-8 max-w-xl text-base text-brand-100/85 md:text-lg">{t('home.hero.intro')}</p>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
        <Button href={getLocalizedPath('services', lang)} variant="accent" size="lg">
          {t('home.hero.ctaPrimary')}
          <span aria-hidden="true">→</span>
        </Button>
        <Button
          {...getBookingLink(
            t('home.hero.ctaSecondary'),
            t('booking.newTab'),
            getLocalizedPath('contact', lang),
          )}
          variant="outline-light"
          size="lg"
        >
          {t('home.hero.ctaSecondary')}
        </Button>
      </div>
    </div>

    <div class="hero-reveal lg:col-span-5">
      <HeroTerminal
        client:visible
        label={t('home.hero.terminalLabel')}
        command={t('home.hero.terminalCommand')}
        steps={steps}
        done={t('home.hero.terminalDone')}
      />
    </div>
  </div>

  <!-- Bandeau bas : devise et invitation à défiler -->
  <div class="relative border-t border-brand-300/15">
    <div
      class="pointer-events-none absolute inset-x-0 -top-px h-px bg-linear-to-r from-transparent via-accent-300/70 to-transparent"
      aria-hidden="true"
    >
    </div>
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-4 py-5 md:px-8 md:py-6">
      <p class="font-mono text-sm text-brand-100/80 md:text-base">
        <span class="text-accent-300" aria-hidden="true">// </span>{t('site.motto')}
      </p>
      <a
        href="#atouts"
        class="group hidden items-center gap-3 text-xs font-semibold tracking-[0.2em] text-brand-100/80 uppercase no-underline hover:text-accent-300 sm:inline-flex"
      >
        {t('home.hero.scroll')}
        <span
          class="flex size-9 items-center justify-center rounded-full border border-brand-300/40 transition-transform group-hover:translate-y-0.5"
          aria-hidden="true"
        >
          ↓
        </span>
      </a>
    </div>
  </div>
</section>

<style>
  @keyframes reveal {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero-reveal {
    animation: reveal 0.8s ease-out both;
  }

  .hero-reveal + .hero-reveal {
    animation-delay: 0.15s;
  }
</style>
