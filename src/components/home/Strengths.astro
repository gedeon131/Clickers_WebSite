---
/**
 * « Pourquoi Clickers » : contexte (présentation §1.2) et les cinq atouts (§4.1 à 4.5),
 * avec une carte d'appel à l'action en sixième case.
 */
import Section from '../ui/Section.astro';
import { getLangFromUrl, getLocalizedPath, useTranslations, type UiKey } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const strengths = [
  {
    key: 'team',
    // Groupe de personnes
    icon: 'M9 11a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7zM2.5 20a6.5 6.5 0 0 1 13 0M16 4.3a3.5 3.5 0 0 1 0 6.4M18.5 14a6.5 6.5 0 0 1 3 6',
  },
  {
    key: 'agile',
    // Cycle itératif
    icon: 'M4 12a8 8 0 0 1 14-5.3M20 4v5h-5M20 12a8 8 0 0 1-14 5.3M4 20v-5h5',
  },
  {
    key: 'expertise',
    // Couches technologiques
    icon: 'M12 3l9 5-9 5-9-5zM3 13l9 5 9-5M3 17l9 5 9-5',
  },
  {
    key: 'product',
    // Ampoule
    icon: 'M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2.1h5c0-.9.4-1.6 1-2.1A6 6 0 0 0 12 3z',
  },
  {
    key: 'experience',
    // Médaille / expérience
    icon: 'M12 15a6 6 0 1 0 0-12 6 6 0 0 0 0 12zM8.5 14l-1.5 7 5-2.5 5 2.5-1.5-7',
  },
].map(({ key, icon }) => ({
  title: t(`strength.${key}.title` as UiKey),
  text: t(`strength.${key}.text` as UiKey),
  icon,
}));
---

<Section
  id="atouts"
  tone="paper"
  eyebrow={t('home.strengths.eyebrow')}
  title={t('home.strengths.title')}
  intro={t('home.strengths.intro')}
>
  <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3" role="list">
    {strengths.map(({ title, text, icon }, index) => (
      <li
        data-reveal
        class="group relative flex flex-col overflow-hidden rounded-xl border border-brand-100 bg-white p-7 shadow-sm shadow-night-900/5 transition-all duration-300 hover:-translate-y-1 hover:border-brand-500/30 hover:shadow-lg hover:shadow-brand-700/10 md:p-8"
        style={`transition-delay: ${index * 60}ms`}
      >
        <div class="flex items-start justify-between">
          <span class="flex size-12 items-center justify-center rounded-lg bg-brand-100 text-brand-700 transition-colors group-hover:bg-brand-700 group-hover:text-white">
            <svg
              class="size-6"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d={icon} />
            </svg>
          </span>
          <span class="font-mono text-xs text-muted">{String(index + 1).padStart(2, '0')}</span>
        </div>
        <h3 class="mt-7 text-xl">{title}</h3>
        <p class="mt-3 text-muted">{text}</p>
      </li>
    ))}
    <li
      data-reveal
      class="relative flex flex-col justify-between overflow-hidden rounded-xl bg-linear-to-br from-brand-700 to-accent-500 p-7 text-white md:p-8"
      style="transition-delay: 300ms"
    >
      <div>
        <h3 class="text-2xl text-white">{t('home.strengths.ctaTitle')}</h3>
        <p class="mt-3 text-white/90">{t('home.strengths.ctaText')}</p>
      </div>
      <a
        href={`${getLocalizedPath('contact', lang)}#devis`}
        class="mt-8 inline-flex items-center gap-2 self-start rounded-md bg-white px-5 py-3 text-xs font-semibold tracking-[0.12em] text-brand-700 uppercase no-underline transition-colors hover:bg-brand-100"
      >
        {t('home.strengths.ctaLink')}
        <span aria-hidden="true">→</span>
      </a>
    </li>
  </ul>
</Section>
