---
/**
 * « Pour qui » : les marchés visés (présentation §7.2).
 */
import Section from '../ui/Section.astro';
import { getLangFromUrl, useTranslations, type UiKey } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const markets = [
  {
    key: 'public',
    // Édifice public
    icon: 'M3 10l9-6 9 6M5 10v8M9 10v8M15 10v8M19 10v8M3 20h18',
  },
  {
    key: 'private',
    // Mallette
    icon: 'M4 8h16v11H4zM9 8V5h6v3M4 13h16',
  },
  {
    key: 'education',
    // Livres
    icon: 'M4 19V5a2 2 0 0 1 2-2h13v15H6a2 2 0 0 0-2 2 2 2 0 0 0 2 2h13M8 7h7',
  },
  {
    key: 'ngo',
    // Globe
    icon: 'M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM3 12h18M12 3c2.5 2.7 3.5 5.7 3.5 9s-1 6.3-3.5 9c-2.5-2.7-3.5-5.7-3.5-9s1-6.3 3.5-9z',
  },
].map(({ key, icon }) => ({
  title: t(`market.${key}.title` as UiKey),
  text: t(`market.${key}.text` as UiKey),
  icon,
}));
---

<Section
  id="publics"
  tone="deep"
  eyebrow={t('home.markets.eyebrow')}
  title={t('home.markets.title')}
  intro={t('home.markets.intro')}
>
  <ul class="grid gap-x-8 gap-y-12 sm:grid-cols-2 lg:grid-cols-4" role="list">
    {markets.map(({ title, text, icon }, index) => (
      <li
        data-reveal
        class="relative border-t border-brand-300/25 pt-8"
        style={`transition-delay: ${index * 80}ms`}
      >
        <span
          class="absolute -top-px left-0 h-px w-12 bg-linear-to-r from-brand-500 to-accent-300"
          aria-hidden="true"
        ></span>
        <svg
          class="size-8 text-accent-300"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.3"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d={icon} />
        </svg>
        <h3 class="mt-6 text-lg text-white">{title}</h3>
        <p class="mt-3 text-brand-100/80">{text}</p>
      </li>
    ))}
  </ul>
</Section>
