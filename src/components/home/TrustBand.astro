---
/**
 * Bandeau « Ils nous font confiance » (inspiré de ddghaiti.com).
 * Les partenaires sont listés dans `partners` (src/config/site.ts). Tant qu'un partenaire n'a pas
 * fourni son logo ni autorisé la citation de son nom, une tuile texte anonymisée est affichée.
 */
import { partners } from '../../config/site';
import { getLangFromUrl, getLocalizedPath, useTranslations, type UiKey } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const icons: Record<string, string> = {
  public: 'M3 10l9-6 9 6M5 10v8M9 10v8M15 10v8M19 10v8M3 20h18',
  education: 'M2 9l10-5 10 5-10 5zM6 11v5c0 1.7 2.7 3 6 3s6-1.3 6-3v-5',
  creators: 'M4 5h16v14H4zM4 15l4-4 4 4 3-3 5 5M15.5 9.5h.01',
};
---

<section class="border-b border-brand-100 bg-white" aria-labelledby="confiance-titre">
  <div class="mx-auto max-w-7xl px-4 py-14 md:px-8 md:py-16">
    <div data-reveal class="flex flex-col gap-3 text-center">
      <p class="font-mono text-xs text-accent-700">
        <span aria-hidden="true">// </span>{t('trust.eyebrow')}
      </p>
      <h2 id="confiance-titre" class="text-2xl md:text-3xl">{t('trust.title')}</h2>
      <p class="mx-auto max-w-2xl text-muted">{t('trust.intro')}</p>
    </div>

    <ul data-reveal class="mt-10 grid grid-cols-2 gap-4 md:grid-cols-4" role="list">
      {partners.map(({ labelKey, icon, logo, name }) => (
        <li class="flex min-h-28 flex-col items-center justify-center gap-3 rounded-xl border border-brand-100 bg-paper px-4 py-6 text-center grayscale transition hover:grayscale-0">
          {logo ? (
            <img src={logo} alt={name ?? t(labelKey as UiKey)} class="max-h-12 w-auto" loading="lazy" />
          ) : (
            <>
              <svg
                class="size-8 text-steel-700"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.4"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d={icons[icon]} />
              </svg>
              <span class="font-display text-sm font-semibold text-steel-700">
                {name ?? t(labelKey as UiKey)}
              </span>
            </>
          )}
        </li>
      ))}
      <li>
        <a
          href={`${getLocalizedPath('contact', lang)}#devis`}
          class="group flex h-full min-h-28 flex-col items-center justify-center gap-2 rounded-xl border border-dashed border-brand-700/30 px-4 py-6 text-center no-underline transition-colors hover:border-brand-700 hover:bg-brand-100/50"
        >
          <span class="font-display text-sm font-semibold text-brand-700">{t('trust.you')}</span>
          <span class="text-xs text-accent-700 group-hover:underline">
            {t('trust.youLink')} <span aria-hidden="true">→</span>
          </span>
        </a>
      </li>
    </ul>
  </div>
</section>
