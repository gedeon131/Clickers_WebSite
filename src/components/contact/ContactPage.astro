---
import NetworkPattern from '../ui/NetworkPattern.astro';
/**
 * Page Contact, partagée par /contact et /en/contact :
 * canaux directs (e-mail, WhatsApp, rendez-vous, réseaux), formulaire de contact, demande de devis.
 */
import ContactForm from '../forms/ContactForm.astro';
import QuoteForm from '../forms/QuoteForm.astro';
import Faq from '../ui/Faq.astro';
import PageHeader from '../ui/PageHeader.astro';
import SocialLinks from '../ui/SocialLinks.astro';
import {
  bookingUrl,
  contactEmail,
  getWhatsAppHref,
  phoneDisplay,
  phoneHref,
} from '../../config/site';
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const whatsappHref = getWhatsAppHref(t('whatsapp.message'));

const channelTitle = 'font-mono text-xs text-accent-300';
const channelLink =
  'mt-2 inline-flex items-center gap-2 text-base font-medium text-paper no-underline hover:text-accent-300';
---

<PageHeader
  eyebrow={t('contact.eyebrow')}
  title={t('contact.heading')}
  intro={t('contact.intro')}
  breadcrumbs={[{ label: t('contact.title') }]}
/>

<!-- Canaux directs + formulaire de contact -->
<section class="bg-paper" aria-labelledby="contact-form-titre">
  <div class="mx-auto grid max-w-7xl grid-cols-[minmax(0,1fr)] gap-10 px-4 py-16 md:px-8 md:py-24 lg:grid-cols-12 lg:gap-12">
    <aside class="lg:col-span-4">
      <div class="relative overflow-hidden rounded-xl bg-night-900 p-8 text-brand-100 md:p-10 lg:sticky lg:top-36">
        <NetworkPattern class="pointer-events-none absolute -right-20 -bottom-20 size-72 text-brand-300 opacity-[0.1]" />
        <h2 class="font-display text-2xl text-paper">{t('contact.channels.title')}</h2>
        <span class="mt-5 block h-px w-10 bg-accent-500" aria-hidden="true"></span>

        <dl class="relative mt-8 space-y-8">
          <div>
            <dt class={channelTitle}>{t('contact.channels.email')}</dt>
            <dd>
              <a href={`mailto:${contactEmail}`} class:list={[channelLink, 'break-all']}>
                {contactEmail}
              </a>
            </dd>
          </div>

          <div>
            <dt class={channelTitle}>{t('contact.channels.phone')}</dt>
            <dd>
              <a href={phoneHref} class={channelLink}>
                {phoneDisplay}
              </a>
              {whatsappHref && (
                <p class="mt-2">
                  <a
                    href={whatsappHref}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 text-sm text-accent-300 no-underline hover:text-white"
                  >
                    {t('contact.channels.whatsappAction')}
                    <span aria-hidden="true">→</span>
                  </a>
                </p>
              )}
            </dd>
          </div>

          <div>
            <dt class={channelTitle}>{t('contact.channels.booking')}</dt>
            <dd>
              {bookingUrl ? (
                <a
                  href={bookingUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-3 inline-flex items-center gap-2 rounded-md btn-gradient px-5 py-3 text-xs font-semibold tracking-[0.15em] text-white uppercase no-underline"
                >
                  {t('contact.channels.bookingAction')}
                  <span aria-hidden="true">→</span>
                </a>
              ) : (
                <p class="mt-2 text-sm text-brand-100/80">{t('contact.channels.bookingSoon')}</p>
              )}
            </dd>
          </div>

          <div>
            <dt class={channelTitle}>{t('contact.channels.social')}</dt>
            <dd class="mt-3">
              <SocialLinks />
            </dd>
          </div>
        </dl>
      </div>
    </aside>

    <div class="lg:col-span-8">
      <p class="mb-5 flex items-center gap-4 text-xs font-semibold tracking-[0.2em] text-accent-700 uppercase">
        <span class="h-px w-10 bg-current" aria-hidden="true"></span>
        {t('contact.form.eyebrow')}
      </p>
      <h2 id="contact-form-titre" class="text-3xl leading-tight md:text-4xl">
        {t('contact.form.title')}
      </h2>
      <p class="mt-4 mb-10 text-muted">{t('contact.form.intro')}</p>
      <ContactForm labelledby="contact-form-titre" />
    </div>
  </div>
</section>

<!-- Demande de devis -->
<section id="devis" class="scroll-mt-28 bg-brand-100" aria-labelledby="devis-titre">
  <div class="mx-auto grid max-w-7xl grid-cols-[minmax(0,1fr)] gap-10 px-4 py-16 md:px-8 md:py-24 lg:grid-cols-12 lg:gap-12">
    <header class="lg:col-span-4">
      <p class="mb-5 flex items-center gap-4 text-xs font-semibold tracking-[0.2em] text-brand-500 uppercase">
        <span class="h-px w-10 bg-accent-500" aria-hidden="true"></span>
        {t('contact.quote.eyebrow')}
      </p>
      <h2 id="devis-titre" class="text-3xl leading-tight md:text-4xl">
        {t('contact.quote.title')}
      </h2>
      <p class="mt-4 text-muted">{t('contact.quote.intro')}</p>
    </header>
    <div class="rounded-xl bg-white p-6 shadow-sm shadow-night-900/5 md:p-10 lg:col-span-8">
      <QuoteForm labelledby="devis-titre" />
    </div>
  </div>
</section>

<Faq items={['quote', 'delays', 'process', 'remote', 'confidentiality']} showContact={false} />
